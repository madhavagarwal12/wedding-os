DATABASE_URL="postgres://postgres@localhost:5433/weddingos?sslmode=disable"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Local file storage for uploaded documents
UPLOADS_DIR="./uploads"

# Optional: used by `npx prisma db seed` to create the first Owner account
SEED_OWNER_EMAIL="owner@yourcompany.com"
SEED_OWNER_PASSWORD="change-me-after-first-login"

# Shared secret for the daily notification cron endpoint
# (/api/cron/daily-notifications). Generate with: openssl rand -hex 32
CRON_SECRET=""
