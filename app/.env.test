# Used by integration tests (src/__tests__/integration/**) and by
# `npx prisma migrate deploy` when pointed at the test database.
# Same local Postgres instance as dev, separate database so integration
# tests can freely truncate/reset without touching real dev data.
DATABASE_URL="postgres://postgres@localhost:5433/weddingos_test?sslmode=disable"
AUTH_SECRET="test-secret-not-used-at-runtime"
UPLOADS_DIR="./uploads-test"
