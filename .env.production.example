# Copy this to `.env.production` directly on the VPS (never commit the real
# file — it's created by hand with `nano .env.production` as described in
# the deployment plan). docker-compose.vps.yml loads it via `env_file`.

# Postgres password used by both the `postgres` and `app`/`migrate`
# services below. Generate with: openssl rand -hex 24
# (hex only — a base64 password can contain +, /, = which break the
# connection URL that docker-compose.vps.yml assembles from this value)
POSTGRES_PASSWORD=

# Auth.js session secret. Generate with: npx auth secret
AUTH_SECRET=

# Local file storage for uploaded documents (mounted as a Docker volume —
# see uploads_data in docker-compose.vps.yml). Leave as-is.
UPLOADS_DIR=./uploads

# Creates the first Owner account when `prisma db seed` runs.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Shared secret for the daily notification cron endpoint
# (/api/cron/daily-notifications). Generate with: openssl rand -hex 32
CRON_SECRET=

NODE_ENV=production
